# Copie este arquivo para `.env` e preencha os valores.
#
#     cp .env.example .env

# Obrigatória. Chave do Google AI Studio (https://aistudio.google.com/apikey).
GOOGLE_API_KEY=

# Opcional. Modelo Gemini usado por todos os agentes.
# Padrão: gemini-2.5-flash
# Confira os modelos e limites ativos do seu projeto no Google AI Studio,
# porque eles mudam com frequência. O nível gratuito tem cota diária baixa.
AURORA_MODELO=

# Opcional. Banco SQLite que guarda sessões e eventos do ADK.
# Padrão: aurora.db
AURORA_DB=

# Opcional. Banco SQLite que guarda os dados do condomínio
# (apartamentos, áreas, reservas, visitantes).
# Padrão: aurora-dominio.db
AURORA_DB_DOMINIO=

# ---------------------------------------------------------------------------
# OPCIONAL — caminho alternativo de desenvolvimento.
#
# Preencha AURORA_GATEWAY_URL para apontar os agentes a um gateway compatível
# com a API da OpenAI, em vez do Google AI Studio. Exige instalar o extra:
#
#     uv sync --extra gateway
#
# Este NÃO é o caminho exigido pelo enunciado. O padrão do projeto continua
# sendo Gemini com chave do Google AI Studio; deixe estas variáveis vazias
# para usá-lo.
# ---------------------------------------------------------------------------

# URL base do gateway, incluindo o caminho da API.
AURORA_GATEWAY_URL=

# Token de autenticação do gateway.
AURORA_GATEWAY_TOKEN=

# Identificador do modelo como o gateway o conhece (ex.: gemini-3.8-flash).
# Se ficar vazio, usa o valor de AURORA_MODELO.
AURORA_GATEWAY_MODELO=

# Nome do cabeçalho HTTP que o gateway espera para o token, quando ele não usa
# o padrão `Authorization: Bearer`. Deixe vazio se o gateway usar o padrão.
AURORA_GATEWAY_HEADER=
